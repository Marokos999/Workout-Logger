<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutLogger.Mobile.ViewModel"
             xmlns:svc="clr-namespace:WorkoutLogger.Mobile.Services"
             x:Class="WorkoutLogger.Mobile.View.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <x:Static Member="svc:LocalizationService.Instance" x:Key="Loc" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">

        <Label Text="{Binding [AppTitle], Source={StaticResource Loc}}"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,0,0,24" />

        <Entry Placeholder="{Binding [Email], Source={StaticResource Loc}}"
               Text="{Binding Email}"
               Keyboard="Email" />

        <Entry Placeholder="{Binding [Password], Source={StaticResource Loc}}"
               Text="{Binding Password}"
               IsPassword="True" />

        <Label Text="{Binding ErrorMessage}"
               TextColor="Red"
               FontSize="13" />

        <Button Text="{Binding [Login], Source={StaticResource Loc}}"
                Command="{Binding LoginCommand}"
                Margin="0,8,0,0" />

        <Button Text="{Binding [NoAccount], Source={StaticResource Loc}}"
                Command="{Binding GoToRegisterCommand}"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light=#512BD4, Dark=#AC99EA}" />

    </VerticalStackLayout>

</ContentPage>
