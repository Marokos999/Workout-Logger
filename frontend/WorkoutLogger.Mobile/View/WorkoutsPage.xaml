<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutLogger.Mobile.ViewModel"
             xmlns:svc="clr-namespace:WorkoutLogger.Mobile.Services"
             x:Class="WorkoutLogger.Mobile.View.WorkoutsPage"
             x:DataType="vm:WorkoutsViewModel"
             x:Name="Root"
             Title="{Binding [PageWorkouts], Source={StaticResource Loc}}">

    <ContentPage.Resources>
        <x:Static Member="svc:LocalizationService.Instance" x:Key="Loc" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding GoToCreateCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Margin="0,8" />

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Sessions}" Margin="16">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Margin="0,48">
                        <Label Text="💪" HorizontalOptions="Center" FontSize="48" />
                        <Label Text="{Binding [EmptyWorkouts], Source={StaticResource Loc}}"
                               HorizontalOptions="Center"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="{Binding [EmptyWorkoutsHint], Source={StaticResource Loc}}"
                               HorizontalOptions="Center"
                               TextColor="Gray"
                               FontSize="14" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Null}">
                        <Border Stroke="#E0E0E0" StrokeThickness="1" Margin="0,4" Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding StartedAt, StringFormat='📅 {0:dd.MM.yyyy HH:mm}'}"
                                           TextColor="Gray" FontSize="13" />
                                    <Label Text="{Binding EndedAt, StringFormat='✓ {0:HH:mm}'}"
                                           TextColor="#512BD4" FontSize="12" FontAttributes="Bold" />
                                    <Label Text="{Binding Notes}"
                                           TextColor="Gray" FontSize="12"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Notes}" Value="{x:Null}">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="✕"
                                        BackgroundColor="Transparent"
                                        TextColor="Red"
                                        FontSize="18"
                                        VerticalOptions="Start"
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeleteCommand}"
                                        CommandParameter="{Binding Id}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <StackLayout Padding="16,8">
                        <Button Text="{Binding [LoadMore], Source={StaticResource Loc}}"
                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.LoadMoreCommand}"
                                IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.HasMore}"
                                BackgroundColor="#512BD4"
                                TextColor="White"
                                CornerRadius="8" />
                        <ActivityIndicator IsRunning="{Binding Source={x:Reference Root}, Path=BindingContext.IsLoadingMore}"
                                           IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.IsLoadingMore}"
                                           Color="#512BD4"
                                           Margin="0,4" />
                    </StackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
