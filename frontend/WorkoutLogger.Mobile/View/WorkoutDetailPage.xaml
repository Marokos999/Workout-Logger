<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutLogger.Mobile.ViewModel"
             x:Class="WorkoutLogger.Mobile.View.WorkoutDetailPage"
             x:DataType="vm:WorkoutDetailViewModel"
             x:Name="Root"
             Title="{Binding Session.Name}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Set"
                     Command="{Binding GoToAddSetCommand}"
                     IsEnabled="{Binding IsActive}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Margin="0,8" />

        <VerticalStackLayout Grid.Row="1" Padding="16,8" Spacing="4">
            <Label Text="{Binding Session.StartedAt, StringFormat='Početak: {0:dd.MM.yyyy HH:mm}'}"
                   TextColor="Gray" FontSize="13" />
            <Label Text="{Binding Session.EndedAt, StringFormat='Kraj: {0:dd.MM.yyyy HH:mm}'}"
                   TextColor="Gray" FontSize="13"
                   IsVisible="{Binding HasEnded}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Session.WorkoutSets}" Margin="16,0">
            <CollectionView.EmptyView>
                <Label Text="Nema setova. Dodaj prvi set!"
                       HorizontalOptions="Center"
                       TextColor="Gray"
                       Margin="0,32" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Null}">
                    <Border Stroke="#E0E0E0" StrokeThickness="1" Margin="0,4" Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding SetNumber, StringFormat='#{0}'}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0"
                                   TextColor="#512BD4" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding ExerciseName}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding Reps, StringFormat='{0} ponavljanja'}"
                                       TextColor="Gray" FontSize="13" />
                                <Label Text="{Binding Weight, StringFormat='{0} kg'}"
                                       TextColor="Gray" FontSize="13" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="✕"
                                    BackgroundColor="Transparent"
                                    TextColor="Red"
                                    FontSize="18"
                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeleteSetCommand}"
                                    CommandParameter="{Binding Id}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3"
                Text="Završi trening"
                Command="{Binding EndWorkoutCommand}"
                Margin="16"
                BackgroundColor="#512BD4"
                IsVisible="{Binding IsActive}" />

    </Grid>

</ContentPage>
