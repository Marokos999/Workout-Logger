<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutLogger.Mobile.ViewModel"
             xmlns:svc="clr-namespace:WorkoutLogger.Mobile.Services"
             x:Class="WorkoutLogger.Mobile.View.WorkoutDetailPage"
             x:DataType="vm:WorkoutDetailViewModel"
             x:Name="Root"
             Title="{Binding Session.Name}">

    <ContentPage.Resources>
        <x:Static Member="svc:LocalizationService.Instance" x:Key="Loc" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding [AddSet], Source={StaticResource Loc}}"
                     Command="{Binding GoToAddSetCommand}"
                     IsEnabled="{Binding IsActive}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Margin="0,8" />

        <VerticalStackLayout Grid.Row="1" Padding="16,8" Spacing="4">
            <Label Text="{Binding Session.StartedAt, StringFormat='📅 {0:dd.MM.yyyy HH:mm}'}"
                   TextColor="Gray" FontSize="13" />
            <Label Text="{Binding Session.EndedAt, StringFormat='🏁 {0:dd.MM.yyyy HH:mm}'}"
                   TextColor="Gray" FontSize="13"
                   IsVisible="{Binding HasEnded}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Session.WorkoutSets}" Margin="16,0">
            <CollectionView.EmptyView>
                <Label Text="{Binding [NoSets], Source={StaticResource Loc}}"
                       HorizontalOptions="Center"
                       TextColor="Gray"
                       Margin="0,32" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Null}">
                    <Border Stroke="#E0E0E0" StrokeThickness="1" Margin="0,4" Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding SetNumber, StringFormat='#{0}'}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0"
                                   TextColor="#512BD4" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding ExerciseName}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding Reps, StringFormat='{0} reps'}"
                                       TextColor="Gray" FontSize="13" />
                                <Label Text="{Binding Weight, StringFormat='{0} kg'}"
                                       TextColor="Gray" FontSize="13" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="✕"
                                    BackgroundColor="Transparent"
                                    TextColor="Red"
                                    FontSize="18"
                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeleteSetCommand}"
                                    CommandParameter="{Binding Id}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="3"
                IsVisible="{Binding IsActive}"
                Margin="16,4"
                Padding="16,10"
                Stroke="#E8E0F7"
                StrokeThickness="1"
                BackgroundColor="#F5F0FF">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Label Grid.Column="0"
                       Text="{Binding [Rest], Source={StaticResource Loc}}"
                       VerticalOptions="Center"
                       FontSize="14"
                       TextColor="#512BD4"
                       FontAttributes="Bold" />
                <Label Grid.Column="1"
                       Text="{Binding RestDisplay}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#512BD4">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding TimerFinished}" Value="True">
                            <Setter Property="TextColor" Value="Green" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label Grid.Column="2"
                       Text="{Binding [TimerDone], Source={StaticResource Loc}}"
                       IsVisible="{Binding TimerFinished}"
                       VerticalOptions="Center"
                       TextColor="Green"
                       FontSize="13"
                       Margin="0,0,8,0" />
                <Button Grid.Column="3"
                        Text="↺"
                        Command="{Binding ResetTimerCommand}"
                        WidthRequest="40" HeightRequest="40"
                        BackgroundColor="Transparent"
                        TextColor="#512BD4"
                        FontSize="18" />
            </Grid>
        </Border>

        <Button Grid.Row="4"
                Text="{Binding [EndWorkout], Source={StaticResource Loc}}"
                Command="{Binding EndWorkoutCommand}"
                Margin="16"
                BackgroundColor="#512BD4"
                IsVisible="{Binding IsActive}" />

    </Grid>

</ContentPage>
