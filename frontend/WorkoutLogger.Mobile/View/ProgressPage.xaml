<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutLogger.Mobile.ViewModel"
             xmlns:svc="clr-namespace:WorkoutLogger.Mobile.Services"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="WorkoutLogger.Mobile.View.ProgressPage"
             x:DataType="vm:ProgressViewModel"
             Title="{Binding [PageProgress], Source={StaticResource Loc}}">

    <ContentPage.Resources>
        <x:Static Member="svc:LocalizationService.Instance" x:Key="Loc" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding [Logout], Source={StaticResource Loc}}"
                     Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Margin="0,8" />

            <Label Text="{Binding [VolumeByExercise], Source={StaticResource Loc}}"
                   FontAttributes="Bold" FontSize="16" TextColor="#512BD4" />

            <lvc:CartesianChart Series="{Binding VolumeSeries}"
                                XAxes="{Binding VolumeXAxes}"
                                YAxes="{Binding VolumeYAxes}"
                                HeightRequest="220" />

            <Label Text="{Binding [ProgressByExercise], Source={StaticResource Loc}}"
                   FontAttributes="Bold" FontSize="16" TextColor="#512BD4" Margin="0,4,0,0" />

            <Picker Title="{Binding [SelectExPicker], Source={StaticResource Loc}}"
                    ItemsSource="{Binding Records}"
                    ItemDisplayBinding="{Binding ExerciseName}"
                    SelectedItem="{Binding SelectedRecord}" />

            <ActivityIndicator IsRunning="{Binding IsChartBusy}"
                               IsVisible="{Binding IsChartBusy}" />

            <lvc:CartesianChart Series="{Binding ProgressSeries}"
                                XAxes="{Binding ProgressXAxes}"
                                YAxes="{Binding ProgressYAxes}"
                                HeightRequest="220" />

            <Label Text="{Binding [PersonalRecords], Source={StaticResource Loc}}"
                   FontAttributes="Bold" FontSize="16" TextColor="#512BD4" Margin="0,4,0,0" />

            <CollectionView ItemsSource="{Binding Records}">
                <CollectionView.EmptyView>
                    <Label Text="{Binding [NoRecords], Source={StaticResource Loc}}"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Null}">
                        <Border Stroke="#E0E0E0" StrokeThickness="1" Margin="0,4" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding ExerciseName}"
                                       FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding MaxWeight, StringFormat='{0} kg'}"
                                       FontAttributes="Bold" FontSize="16"
                                       TextColor="#512BD4" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
