<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutLogger.Mobile.ViewModel"
             xmlns:svc="clr-namespace:WorkoutLogger.Mobile.Services"
             x:Class="WorkoutLogger.Mobile.View.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="{Binding [PageProfile], Source={StaticResource Loc}}">

    <ContentPage.Resources>
        <x:Static Member="svc:LocalizationService.Instance" x:Key="Loc" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="24" Spacing="0">

        <!-- Avatar -->
        <Border WidthRequest="80" HeightRequest="80"
                HorizontalOptions="Center"
                BackgroundColor="#EDE9FA"
                Margin="0,32,0,16">
            <Border.StrokeShape>
                <Ellipse />
            </Border.StrokeShape>
            <Label Text="{Binding Initials}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#512BD4" />
        </Border>

        <Label Text="{Binding Username}"
               HorizontalOptions="Center"
               FontSize="20"
               FontAttributes="Bold"
               Margin="0,0,0,4" />
        <Label Text="{Binding Email}"
               HorizontalOptions="Center"
               TextColor="Gray"
               FontSize="14"
               Margin="0,0,0,24" />

        <!-- Info kartica -->
        <Border Padding="16" Margin="0,0,0,24"
                Stroke="#E0E0E0" StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding [UsernameLabel], Source={StaticResource Loc}}"
                           TextColor="Gray" FontSize="14" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Username}"
                           FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="0.5" Color="#E0E0E0" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding [EmailLabel], Source={StaticResource Loc}}"
                           TextColor="Gray" FontSize="14" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Email}"
                           FontSize="14" TextColor="Gray" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Language toggle -->
        <Border Padding="16" Margin="0,0,0,24"
                Stroke="#E0E0E0" StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Grid.Column="0"
                       Text="{Binding [Language], Source={StaticResource Loc}}"
                       TextColor="Gray" FontSize="14" VerticalOptions="Center" />
                <Button x:Name="BtnSr"
                        Grid.Column="1" Text="SR"
                        Clicked="OnLanguageSr"
                        WidthRequest="52" HeightRequest="36"
                        FontSize="13" FontAttributes="Bold"
                        CornerRadius="8"
                        BackgroundColor="#512BD4"
                        TextColor="White" />
                <Button x:Name="BtnEn"
                        Grid.Column="2" Text="EN"
                        Clicked="OnLanguageEn"
                        WidthRequest="52" HeightRequest="36"
                        FontSize="13" FontAttributes="Bold"
                        CornerRadius="8"
                        BackgroundColor="#EDE9FA"
                        TextColor="#512BD4" />
            </Grid>
        </Border>

        <Button Text="{Binding [LogoutButton], Source={StaticResource Loc}}"
                Command="{Binding LogoutCommand}"
                BackgroundColor="#FFEDEE"
                TextColor="#D32F2F"
                CornerRadius="12"
                FontAttributes="Bold" />

    </VerticalStackLayout>

</ContentPage>
