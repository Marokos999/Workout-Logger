<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutLogger.Mobile.ViewModel"
             xmlns:svc="clr-namespace:WorkoutLogger.Mobile.Services"
             x:Class="WorkoutLogger.Mobile.View.CreateWorkoutPage"
             x:DataType="vm:CreateWorkoutViewModel"
             Title="{Binding [PageNewWorkout], Source={StaticResource Loc}}">

    <ContentPage.Resources>
        <x:Static Member="svc:LocalizationService.Instance" x:Key="Loc" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="24" Spacing="16">

        <Entry Placeholder="{Binding [WorkoutName], Source={StaticResource Loc}}"
               Text="{Binding Name}" />

        <Editor Placeholder="{Binding [Notes], Source={StaticResource Loc}}"
                Text="{Binding Notes}"
                HeightRequest="100"
                AutoSize="TextChanges" />

        <Label Text="{Binding ErrorMessage}"
               TextColor="Red"
               FontSize="13" />

        <Button Text="{Binding [CreateWorkout], Source={StaticResource Loc}}"
                Command="{Binding CreateCommand}"
                Margin="0,8,0,0" />

    </VerticalStackLayout>

</ContentPage>
