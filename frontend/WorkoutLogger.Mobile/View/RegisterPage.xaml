<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutLogger.Mobile.ViewModel"
             xmlns:svc="clr-namespace:WorkoutLogger.Mobile.Services"
             x:Class="WorkoutLogger.Mobile.View.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="{Binding [RegisterTitle], Source={StaticResource Loc}}">

    <ContentPage.Resources>
        <x:Static Member="svc:LocalizationService.Instance" x:Key="Loc" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">

        <Entry Placeholder="{Binding [Username], Source={StaticResource Loc}}"
               Text="{Binding Username}" />

        <Entry Placeholder="{Binding [Email], Source={StaticResource Loc}}"
               Text="{Binding Email}"
               Keyboard="Email" />

        <Entry Placeholder="{Binding [Password], Source={StaticResource Loc}}"
               Text="{Binding Password}"
               IsPassword="True" />

        <Label Text="{Binding ErrorMessage}"
               TextColor="Red"
               FontSize="13" />

        <Button Text="{Binding [Register], Source={StaticResource Loc}}"
                Command="{Binding RegisterCommand}"
                Margin="0,8,0,0" />

    </VerticalStackLayout>

</ContentPage>
